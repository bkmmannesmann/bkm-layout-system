{
  "_meta": {
    "name": "BKM Titelblatt Layout-Spezifikation",
    "version": "2.0.0",
    "source_design_repo": "bkmmannesmann/bkm-design-system",
    "source_indesign": "BKM_Prospekt_Image-Fachbetrieb_DinA4.indd",
    "format": "DIN A4 Hochformat (210mm x 297mm)",
    "units": "mm (Millimeter), pt (Punkt = 1/72 Zoll = 0.3528mm), px (Pixel bei 300dpi)"
  },

  "page": {
    "width_mm": 210,
    "height_mm": 297,
    "bleed_mm": 3,
    "color_space": "CMYK",
    "columns": 2,
    "column_width_mm": 105
  },

  "grid": {
    "description": "DIN A4 in 2 Spalten unterteilt. Oberer Bereich ist ein vollflächiger 16:9-Farbkasten.",
    "left_margin_mm": 18.0,
    "right_margin_mm": 18.0,
    "top_margin_mm": 18.0,
    "content_width_mm": 174.0,
    "key_visual_width_rule": "1/5 der Formatbreite = 42mm",
    "logo_width_rule": "1/5 der Formatbreite = 42mm"
  },

  "color_box_16_9": {
    "description": "Vollflächiger Farbkasten im 16:9-Seitenverhältnis, bildet den oberen Bereich des Titelblatts.",
    "width_mm": 210,
    "height_mm": 118.1,
    "height_calculation": "210 / 16 * 9 = 118.125mm ≈ 118.1mm",
    "height_px_300dpi": 1395,
    "position": { "x_mm": 0, "y_mm": 0 },
    "note": "Der Farbkasten enthält Logo, Headline, Subheadline und Fließtext. Darunter beginnt der Bildbereich."
  },

  "elements": {

    "logo": {
      "description": "BKM Mannesmann Logo, oben links im Farbkasten.",
      "position": {
        "x_mm": 18.0,
        "y_mm": 18.0,
        "x_px_300dpi": 213,
        "y_px_300dpi": 213
      },
      "size": {
        "width_mm": 42.0,
        "width_rule": "1/5 der Formatbreite (210mm / 5 = 42mm)"
      },
      "variant_rules": {
        "on_deep_green": "bkm-logo-white-puregreen.svg (Weiß + Pure Green M)",
        "on_transition_green": "bkm-logo-white-puregreen.svg (Weiß + Pure Green M)",
        "on_stone_grey": "bkm-logo-white-puregreen.svg (Weiß + Pure Green M)",
        "on_pure_green": "bkm-logo-white.svg (komplett Weiß, da Pure Green M verschwinden würde)",
        "on_white": "bkm-logo-stonegrey-puregreen.svg (Stone Grey + Pure Green M)"
      },
      "critical_rule": "Immer die Variante mit höchstem Kontrast zum Hintergrund wählen."
    },

    "headline": {
      "description": "Hauptüberschrift, immer zweizeilig, Versalien. Zeile 1 kürzer als Zeile 2 für homogeneres Erscheinungsbild.",
      "position": {
        "x_mm": 18.0,
        "y_from_logo_bottom_mm": 18.0,
        "y_absolute_mm": 46.1,
        "y_absolute_note": "Logo-Unterkante (~28.1mm) + 18mm Abstand = 46.1mm (gemessen: 40.8mm – Abweichung durch Logo-Höhe)",
        "x_px_300dpi": 213,
        "alignment": "Linke Außenkante des Logos = Beginn der Headline"
      },
      "typography": {
        "font_family": "Unbounded",
        "font_weight": "Black (900)",
        "font_size_pt": 30,
        "font_size_mm": 10.6,
        "line_height_ratio": 1.25,
        "line_height_pt": 37.5,
        "letter_spacing": "-0.025em (-25% Laufweite)",
        "text_transform": "uppercase (Versalien)"
      },
      "color_rules": {
        "default": "#ffffff (Weiß)",
        "on_white_background": "#494949 (Stone Grey)"
      },
      "constraints": {
        "min_lines": 2,
        "max_lines": 2,
        "line_1_rule": "Weniger Zeichen als Zeile 2 (für homogenes Erscheinungsbild)",
        "max_width_mm": 130
      }
    },

    "subheadline": {
      "description": "Subheadline direkt unter der Headline. Nicht in Versalien, gleiche Schriftfamilie.",
      "position": {
        "spacing_rule": "Abstand = 30pt (Zeichenhöhe der Headline) unter Unterkante Headline Zeile 2",
        "spacing_mm": 10.6,
        "x_mm": 18.0,
        "alignment": "Gleiche linke Kante wie Logo und Headline"
      },
      "typography": {
        "font_family": "Unbounded",
        "font_weight": "Black (900)",
        "font_size_pt": 12,
        "font_size_mm": 4.2,
        "letter_spacing": "-0.025em (-25% Laufweite)",
        "text_transform": "none (keine Versalien, normale Schreibweise)"
      },
      "color_rules": {
        "on_deep_green": "#b4e717 (Lime Green)",
        "on_transition_green": "#b4e717 (Lime Green)",
        "on_stone_grey": "#b4e717 (Lime Green)",
        "on_pure_green": "#1c4b42 (Deep Green)",
        "on_white": "#4daf46 (Pure Green)"
      },
      "ratio_to_headline": "Headline:Subheadline = 30pt:12pt = 2.5:1"
    },

    "intro_text": {
      "description": "Fließtext unter der Subheadline. Kurze Einleitung (2-3 Zeilen).",
      "position": {
        "x_mm": 18.0,
        "spacing_rule": "Direkt unter Subheadline (Abstand noch zu definieren)",
        "alignment": "Gleiche linke Kante wie Logo, Headline, Subheadline"
      },
      "typography": {
        "font_family": "TT Norms Pro",
        "font_weight": "Regular (400)",
        "font_size_pt": 12,
        "font_size_mm": 4.2,
        "line_height_ratio": 1.25,
        "line_height_pt": 15,
        "letter_spacing": "-0.015em (-15% Laufweite)"
      },
      "color_rules": {
        "default": "#ffffff (Weiß)",
        "on_white_background": "#494949 (Stone Grey)"
      },
      "constraints": {
        "max_width_mm": 107,
        "max_lines": 3
      }
    },

    "key_visual": {
      "description": "BKM Key Visual (3 gestaffelte Chevron-Formen). Wird IMMER als vorgerenderte Bilddatei platziert, NIEMALS in Code nachgebaut.",
      "position": {
        "horizontal": "Rechte Außenkante bündig mit rechtem Seitenrand (X_right = 210mm)",
        "vertical_rule": "Linke obere Pure-Green-Außenkante auf Flucht der Unterkante des 16:9-Farbkastens",
        "y_top_mm": 102.416,
        "y_top_mm_herleitung": "Chevron-Oberkante 15,709 mm unter der Bildoberkante, trifft damit die 16:9-Kante bei 118,125 mm",
        "note": "Das Key Visual ragt ca. 15.8mm über die Farbkasten-Unterkante hinaus nach oben in den Farbkasten hinein"
      },
      "size": {
        "width_mm": 42.0,
        "width_rule": "1/5 der Formatbreite (210mm / 5 = 42mm)",
        "height_mm": 99.6,
        "aspect_ratio": "Original-Seitenverhältnis beibehalten (1046:2480 = ca. 1:2.37)"
      },
      "variant_rules": {
        "on_dark_backgrounds": "keyvisual-on-dark.png/svg (alle Chevrons Weiß)",
        "on_light_backgrounds": "keyvisual-on-light.png/svg (Pure Green + Transition Green + Deep Green)",
        "forbidden": "NIEMALS auf Pure Green oder Lime Green Hintergrund platzieren!"
      },
      "critical_rules": [
        "NIEMALS in Code nachbauen (kein SVG, kein CSS)",
        "Immer als vorgerenderte Bilddatei verwenden",
        "Rechte Kante bündig mit Seitenrand",
        "Nicht beschneiden"
      ]
    },

    "hero_image": {
      "description": "Großes Bild unterhalb des 16:9-Farbkastens, füllt den restlichen Seitenbereich.",
      "position": {
        "x_mm": 0,
        "y_mm": 118.1,
        "y_note": "Beginnt an der Unterkante des 16:9-Farbkastens"
      },
      "size": {
        "width_mm": 210,
        "height_mm": 178.9,
        "height_calculation": "297mm - 118.1mm = 178.9mm"
      },
      "fit": "cover (Bild füllt den Bereich, wird ggf. beschnitten)",
      "note": "Das Key Visual überlagert den Übergang zwischen Farbkasten und Hero-Bild"
    }
  },

  "variants": {
