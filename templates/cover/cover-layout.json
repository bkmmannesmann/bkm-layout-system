  "spacing_vertical_flow": {
    "description": "Vertikaler Aufbau des Titelblatts von oben nach unten",
    "flow": [
      { "element": "Seitenoberkante", "y_mm": 0 },
      { "element": "Logo Oberkante", "y_mm": 18.0, "rule": "18mm Abstand von oben" },
      { "element": "Logo Unterkante", "y_mm": 28.1, "rule": "Logo-Höhe ca. 10.1mm" },
      { "element": "Headline Oberkante Zeile 1", "y_mm": 46.1, "rule": "18mm unter Logo-Unterkante" },
      { "element": "Headline Unterkante Zeile 1", "y_mm": 56.7, "rule": "30pt Zeichenhöhe" },
      { "element": "Headline Oberkante Zeile 2", "y_mm": 59.3, "rule": "Leading 37.5pt = 13.2mm" },
      { "element": "Headline Unterkante Zeile 2", "y_mm": 69.9, "rule": "30pt Zeichenhöhe" },
      { "element": "Subheadline Oberkante", "y_mm": 80.5, "rule": "30pt (10.6mm) Abstand unter Headline Zeile 2" },
      { "element": "Subheadline Unterkante", "y_mm": 84.7, "rule": "12pt Zeichenhöhe" },
      { "element": "Fließtext Oberkante", "y_mm": 89.0, "rule": "Abstand unter Subheadline (ca. 4mm)" },
      { "element": "Key Visual Oberkante", "y_mm": 102.416, "rule": "Chevron-Oberkante trifft die 16:9-Kante bei 118,125 mm" },
      { "element": "16:9-Farbkasten Unterkante", "y_mm": 118.1, "rule": "210/16*9 = 118.1mm" },
      { "element": "Hero-Bild Oberkante", "y_mm": 118.1, "rule": "Direkt unter Farbkasten" },
      { "element": "Seitenunterkante", "y_mm": 297.0 }
    ]
  },

  "typography_ratios": {
    "headline_to_subheadline": "30pt : 12pt = 2.5 : 1",
    "headline_to_body": "30pt : 12pt = 2.5 : 1",
